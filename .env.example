# ==============================================================================
# Harmonic Geometry - Serverless API Environment Variables (Optional)
# ==============================================================================
# Leave these unset for local development or ephemeral deployments:
# /api/track automatically falls back to an in-memory cache when KV/Redis
# credentials are omitted, and /api/health reports `kvConfigured: false`.

# Vercel KV REST credentials (preferred when using Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash Redis REST credentials (used if KV_REST_API_* are unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated CORS allowlist for /api/track
# Supports exact origins, `https://*.vercel.app`, `http://localhost:*`, and `http://127.0.0.1:*`.
# Wildcard `*` is ignored. Defaults to the production domain, Vercel previews, and localhost/127.0.0.1.
ALLOWED_ORIGINS=https://generative-music-drawing.vercel.app,https://*.vercel.app,http://localhost:*,http://127.0.0.1:*
